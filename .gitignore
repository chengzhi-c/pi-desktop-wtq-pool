node_modules/
dist/
*.norm
*.log
.env*

# Editor and OS artifacts. None ship today; the rules stop the next one from
# riding along in a `git add .`.
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# A stray root directory produced by a tool that expanded an absolute path
# inside the checkout. Windows forbids `:` in a name, so the plain pattern
# cannot match it; `?` covers the combining character some tools leave behind.
/C?/

# The plugin's own data directory holds live credentials, and a debugging session
# that points the plugin at a checkout would otherwise leave them as untracked
# files one `git add .` away from being committed.
signins/
*.info
credentials-archive.json
checkin-slots.json
doctor.txt
settings.json
deleted-signins.json
.tmp*/
# The archive is written to `<name>.<uuid>.tmp` and renamed into place, so a
# process that died between the two leaves a copy of EVERY credential under a
# name the rule above does not match: `.tmp*/` is a directory pattern.
credentials-archive.json.*.tmp
checkin-slots.json.tmp
deleted-signins.json.*.tmp
deleted-signins.json.lock
# Written next to the plugin when the host rewrites its manifest, and the pack
# outputs put beside the repo by a build. Neither belongs in a commit.
manifest.json.tmp
*.piplug
*.tgz
